# Core exclusions to keep build context small
.git/
.gitignore
.dockerignore
README.md
*.md

# Build Artifacts & Temporary Files
output/
build/__pycache__/
*.pyc
*.pyo
__pycache__/
.DS_Store
Thumbs.db

# IDE & Editor Configs
.vscode/
.idea/
*.swp
*.swo

# Input Management
# We ONLY want to send the active model configuration to the Docker daemon.
# Exclude all other models to prevent sending GBs of data.
input/models/
input/examples/

# But KEEP input/_active/ (the current build target)
!input/_active/

# Keep build scripts (needed for context)
!build/
